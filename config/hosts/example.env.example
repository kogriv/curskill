# install.sh копирует этот файл в config/hosts/$(hostname).env,
# если своего .env ещё нет. Живой .env в git не входит.
# Как заполнять — SETUP.md в корне клона. Пустая переменная = дефолт скрипта.
# Сюда не писать пароли, логин Cursor и ключи воркера.

# Каталог профиля стенда. Пусто = ~/.local/share/cursor-stand.
CURSOR_STAND_PROFILE=

# Экран стенда. :105, если xdpyinfo -display :105 не видит живой X.
# Занят — другой номер, его же одна строкой :N в /etc/cursor-stand/display.
CURSOR_STAND_DISPLAY=:105

# Порт x11vnc на localhost. 5916, если ss показывает, что он свободен.
CURSOR_STAND_VNC=5916

# Стол владельца. Только замер мыши, клики сюда запрещены.
CURSOR_STAND_ORIG_DISPLAY=:1

# HTTP-прокси Cursor. Пусто = ходить напрямую. URL пишет человек, порт не угадывать.
CURSOR_STAND_PROXY=

# SOCKS. Пусто, если прокси нет или он не нужен.
CURSOR_STAND_SOCKS=

# Имя профиля прокси, если им пользуется локальный клиент. Иначе не трогать.
PROXY_PROFILE=default

# Куда не слать через прокси. Домены человека дописывают сюда, не вместо localhost.
CURSOR_STAND_NO_PROXY=localhost,127.0.0.1,::1

# Скрипт экрана. Пусто = automation/display/stand-display.sh из этого клона.
CURSOR_STAND_DISPLAY_SH=

# auto, xorg или xvfb. Пусто = auto.
# xvfb — если нет NVIDIA или нет passwordless sudo. xorg — только когда GPU обязателен.
CURSOR_STAND_X=

# Конфиг Xorg. Пусто = файл рядом со скриптом экрана. BusID там заглушка.
CURSKILL_XORG_CONF=

# Папка по умолчанию не задаётся. Каждый чат получает путь флагом -w.
CURSOR_STAND_WORKSPACE=

# Сессии, которые archive не трогает. Пока пусто, archive не запускать.
ARCHIVE_PROTECTED_IDS=
ARCHIVE_PROTECTED_NAMES=

# 1 — пакеты проверены, человек ответил про прокси, монитор и таймер.
# Пока не 1, doctor по glass не кликает.
CURSKILL_SETUP_DONE=

# install.sh copies this file to config/hosts/$(hostname).env
# when that file does not exist yet. The live .env is not in git.
# How to fill it: SETUP.md at the clone root. Russian: SETUP.ru.md.
# An empty variable means the script default.
# Do not write passwords, a Cursor login, or worker keys here.
#
# install.sh копирует этот файл в config/hosts/$(hostname).env,
# если своего .env ещё нет. Живой .env в git не входит.
# Как заполнять — SETUP.ru.md. Пустая переменная = дефолт скрипта.
# Сюда не писать пароли, логин Cursor и ключи воркера.

# Stand profile directory. Empty = ~/.local/share/cursor-stand.
# Каталог профиля стенда. Пусто = ~/.local/share/cursor-stand.
CURSOR_STAND_PROFILE=

# Stand display. :105 when xdpyinfo -display :105 sees no live X.
# If it is taken, another number, and the same :N as one line in /etc/cursor-stand/display.
# Экран стенда. :105, если xdpyinfo не видит живой X. Занят — другой номер.
CURSOR_STAND_DISPLAY=:105

# x11vnc port on localhost. 5916 when ss shows it is free.
# Порт x11vnc на localhost. 5916, если ss показывает, что он свободен.
CURSOR_STAND_VNC=5916

# The owner's desktop. Mouse measurement only. Do not click here.
# Стол владельца. Только замер мыши, клики сюда запрещены.
CURSOR_STAND_ORIG_DISPLAY=:1

# Cursor HTTP proxy. Empty = connect directly. The person writes the URL. Do not guess a port.
# HTTP-прокси Cursor. Пусто = напрямую. URL пишет человек, порт не угадывать.
CURSOR_STAND_PROXY=

# SOCKS. Empty when there is no proxy or it is not wanted.
# SOCKS. Пусто, если прокси нет или он не нужен.
CURSOR_STAND_SOCKS=

# Proxy profile name, if a local client uses one. Otherwise leave it.
# Имя профиля прокси, если им пользуется локальный клиент. Иначе не трогать.
PROXY_PROFILE=default

# Destinations that skip the proxy. Add the person's domains. Do not drop localhost.
# Куда не слать через прокси. Домены человека дописывают сюда, не вместо localhost.
CURSOR_STAND_NO_PROXY=localhost,127.0.0.1,::1

# Screen script. Empty = automation/display/stand-display.sh from this clone.
# Скрипт экрана. Пусто = automation/display/stand-display.sh из этого клона.
CURSOR_STAND_DISPLAY_SH=

# auto, xorg, or xvfb. Empty = auto.
# xvfb when there is no NVIDIA or no passwordless sudo. xorg only when the GPU is required.
# Пусто = auto. xvfb — нет NVIDIA или нет passwordless sudo.
CURSOR_STAND_X=

# Xorg config. Empty = the file next to the screen script. BusID there is a placeholder.
# Конфиг Xorg. Пусто = файл рядом со скриптом. BusID там заглушка.
CURSKILL_XORG_CONF=

# No default folder. Each chat gets a path with -w.
# Папка по умолчанию не задаётся. Каждый чат получает путь флагом -w.
CURSOR_STAND_WORKSPACE=

# Sessions archive must not touch. While empty, do not run archive.
# Сессии, которые archive не трогает. Пока пусто, archive не запускать.
ARCHIVE_PROTECTED_IDS=
ARCHIVE_PROTECTED_NAMES=

# 1 — packages checked, and the person answered about proxy, monitor, and timer.
# Until 1, doctor does not click the glass UI.
# 1 — пакеты проверены, человек ответил про прокси, монитор и таймер.
# Пока не 1, doctor по glass не кликает.
CURSKILL_SETUP_DONE=
